<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground"
    android:fitsSystemWindows="true"
    tools:context=".vistas.DashboardActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:title="Sistema Datalab - Gestión"
        app:titleTextColor="?attr/colorOnPrimary"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GESTIÓN COMERCIAL"
                android:textStyle="bold"
                android:padding="8dp"
                android:textColor="?android:attr/textColorSecondary" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:alignmentMode="alignMargins">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardVenta"
                    style="@style/DashboardCard"
                    android:layout_columnWeight="1">
                    <LinearLayout style="@style/DashboardCardContent">
                        <ImageView style="@style/DashboardIcon" android:src="@android:drawable/ic_menu_save" />
                        <TextView style="@style/DashboardText" android:text="REG. VENTA" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardNuevaOrden"
                    style="@style/DashboardCard"
                    android:layout_columnWeight="1">
                    <LinearLayout style="@style/DashboardCardContent">
                        <ImageView style="@style/DashboardIcon" android:src="@android:drawable/ic_menu_add" />
                        <TextView style="@style/DashboardText" android:text="NUEVA ORDEN" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardRegCliente"
                    style="@style/DashboardCard"
                    android:layout_columnWeight="1">
                    <LinearLayout style="@style/DashboardCardContent">
                        <ImageView style="@style/DashboardIcon" android:src="@android:drawable/ic_input_add" />
                        <TextView style="@style/DashboardText" android:text="REG. CLIENTE" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </GridLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="INVENTARIO Y TALLER"
                android:textStyle="bold"
                android:padding="8dp"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginTop="8dp"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:alignmentMode="alignMargins">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardClientes"
                    style="@style/DashboardCard"
                    android:layout_columnWeight="1">
                    <LinearLayout style="@style/DashboardCardContent">
                        <ImageView style="@style/DashboardIcon" android:src="@android:drawable/ic_menu_myplaces" />
                        <TextView style="@style/DashboardText" android:text="LISTA CLIENTES" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardLaboratorio"
                    style="@style/DashboardCard"
                    android:layout_columnWeight="1">
                    <LinearLayout style="@style/DashboardCardContent">
                        <ImageView style="@style/DashboardIcon" android:src="@android:drawable/ic_menu_manage" />
                        <TextView style="@style/DashboardText" android:text="LABORATORIO" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardRegLaptop"
                    style="@style/DashboardCard"
                    android:layout_columnWeight="1">
                    <LinearLayout style="@style/DashboardCardContent">
                        <ImageView style="@style/DashboardIcon" android:src="@android:drawable/ic_input_add" />
                        <TextView style="@style/DashboardText" android:text="COMPRA DESARME" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </GridLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ADMINISTRACIÓN"
                android:textStyle="bold"
                android:padding="8dp"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginTop="8dp"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:alignmentMode="alignMargins">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardRegTecnico"
                    style="@style/DashboardCard"
                    android:layout_columnWeight="1">
                    <LinearLayout style="@style/DashboardCardContent">
                        <ImageView style="@style/DashboardIcon" android:src="@android:drawable/ic_input_add" />
                        <TextView style="@style/DashboardText" android:text="REG. PERSONAL" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardTecnicos"
                    style="@style/DashboardCard"
                    android:layout_columnWeight="1">
                    <LinearLayout style="@style/DashboardCardContent">
                        <ImageView style="@style/DashboardIcon" android:src="@android:drawable/ic_menu_search" />
                        <TextView style="@style/DashboardText" android:text="VER PERSONAL" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardAsistencia"
                    style="@style/DashboardCard"
                    android:layout_columnWeight="1">
                    <LinearLayout style="@style/DashboardCardContent">
                        <ImageView style="@style/DashboardIcon" android:src="@android:drawable/ic_menu_today" />
                        <TextView style="@style/DashboardText" android:text="ASISTENCIA" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardTaller"
                    style="@style/DashboardCard"
                    android:layout_columnWeight="1">
                    <LinearLayout style="@style/DashboardCardContent">
                        <ImageView style="@style/DashboardIcon" android:src="@android:drawable/ic_menu_preferences" />
                        <TextView style="@style/DashboardText" android:text="TALLER / REPAR." />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </GridLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
