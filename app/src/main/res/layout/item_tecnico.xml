<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="?attr/colorSurface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <ImageView
            android:id="@+id/ivFotoTecnicoItem"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_camera"
            android:background="?attr/colorSurfaceVariant"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivFotoTecnicoItem"
            app:layout_constraintEnd_toStartOf="@id/layoutAcciones">

            <TextView
                android:id="@+id/tvNombreTecnicoItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre Tecnico"
                android:textStyle="bold"
                android:textSize="17sp"
                android:textColor="?attr/colorPrimary"/>

            <TextView
                android:id="@+id/tvTipoTecnicoItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tipo: Trabajador"
                android:textSize="13sp"
                android:textStyle="italic" />

            <TextView
                android:id="@+id/tvInstitutoItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Instituto: Senati"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvDiasItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Días: Lun, Mié, Vie"
                android:textSize="11sp"
                android:textColor="?attr/colorSecondary"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvHorarioItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Horario: 08:00 - 18:00"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutAcciones"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/btnEditarTecnico"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="4dp"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="?attr/colorPrimary"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground" />

            <ImageView
                android:id="@+id/btnEliminarTecnico"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:padding="4dp"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="@color/error_red"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
