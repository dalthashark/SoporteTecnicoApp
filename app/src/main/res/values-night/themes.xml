<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SoporteTecnicoApp" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/blue_light</item> <!-- Lighter blue for visibility -->
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/orange_light</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:windowBackground">@color/bg_dark_navy</item>
        <item name="colorSurface">@color/surface_dark_slate</item>
        <item name="colorSurfaceVariant">#37474F</item>

        <!-- Force high contrast text for inputs in Dark Mode -->
        <item name="editTextColor">@color/white</item>
        <item name="android:editTextColor">@color/white</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">#B0BEC5</item>
        <item name="android:textColorHint">#B0BEC5</item>
    </style>
</resources>
